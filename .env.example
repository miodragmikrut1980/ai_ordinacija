# local = deterministic offline fallback, ollama = local LLM
CLINIC_AI_PROVIDER=local
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Appointment reminders (see app/notifications.py). Default channel used
# when auto-scheduling a reminder for a new appointment; email/sms/viber.
CLINIC_DEFAULT_REMINDER_CHANNEL=email

# Email reminders work with any SMTP account the clinic already has
# (existing email provider, Gmail/Office365, or a local mail relay).
# Leave CLINIC_SMTP_HOST unset to leave email reminders in an
# "unconfigured" state rather than silently doing nothing.
CLINIC_SMTP_HOST=
CLINIC_SMTP_PORT=587
CLINIC_SMTP_USER=
CLINIC_SMTP_PASSWORD=
CLINIC_SMTP_FROM=

# SMS/Viber reminders require a separate paid gateway account this project
# cannot provision for you (e.g. Twilio or a local operator's SMS API for
# CLINIC_SMS_PROVIDER_URL; a Viber Business Messages token for
# CLINIC_VIBER_TOKEN). Until set, those channels stay "unconfigured" and
# staff are shown that the reminder wasn't actually delivered.
CLINIC_SMS_PROVIDER_URL=
CLINIC_VIBER_TOKEN=

